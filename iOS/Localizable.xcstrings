    "Issue reports, feature requests & contributions are always welcome!" : {
      "comment" : "A footer for the settings view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نرحب دائمًا بتقارير المشكلات وطلبات الميزات والمساهمات!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fejlrapporter, funktionsanmodninger og bidrag er altid velkomne!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlerberichte, Funktionswünsche und Beiträge sind jederzeit willkommen!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αναφορές προβλημάτων, οι προτάσεις λειτουργιών και οι συνεισφορές είναι πάντα ευπρόσδεκτες!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Los informes de problemas, las solicitudes de funciones y las contribuciones son siempre bienvenidos!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virheraportit, ominaisuuspyynnöt ja osallistuminen ovat aina tervetulleita!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rapports de problèmes, les demandes de fonctionnalités et les contributions sont toujours les bienvenus !"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דיווחי תקלות, בקשות לתכונות ותרומות תמיד מתקבלים בברכה!"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समस्या रिपोर्ट, फीचर अनुरोध और योगदान हमेशा स्वागत योग्य हैं!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan masalah, permintaan fitur, dan kontribusi selalu diterima!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnalazioni di problemi, richieste di funzionalità e contributi sono sempre benvenuti!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不具合報告、機能リクエスト、開発への貢献をいつでも歓迎します！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문제 보고, 기능 요청 및 기여를 언제나 환영합니다!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probleemmeldingen, functieverzoeken en bijdragen zijn altijd welkom!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgłoszenia błędów, prośby o funkcje i wkład w rozwój są zawsze mile widziane!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщения о проблемах, запросы функций и вклад всегда приветствуются!"
          }
        },
