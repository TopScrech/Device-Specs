    "The assistant can answer follow-up questions and use the built-in device tools" : {
      "comment" : "A description of the assistant's capabilities.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للمساعد الإجابة عن أسئلة المتابعة واستخدام أدوات الجهاز المدمجة"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistenten kan besvare opfølgende spørgsmål og bruge de indbyggede enhedsværktøjer"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Assistent kann Anschlussfragen beantworten und die integrierten Gerätewerkzeuge verwenden"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο βοηθός μπορεί να απαντήσει σε επόμενες ερωτήσεις και να χρησιμοποιήσει τα ενσωματωμένα εργαλεία της συσκευής"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente puede responder preguntas de seguimiento y usar las herramientas integradas del dispositivo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avustaja voi vastata jatkokysymyksiin ja käyttää sisäänrakennettuja laitetyökaluja"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assistant peut répondre aux questions de suivi et utiliser les outils intégrés de l’appareil"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העוזר יכול לענות על שאלות המשך ולהשתמש בכלי המכשיר המובנים"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सहायक आगे के सवालों के जवाब दे सकता है और बिल्ट-इन डिवाइस टूल्स का उपयोग कर सकता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asisten dapat menjawab pertanyaan lanjutan dan menggunakan alat perangkat bawaan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'assistente può rispondere a domande successive e usare gli strumenti integrati del dispositivo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アシスタントは追加の質問に答えたり、内蔵のデバイスツールを使用したりできます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어시스턴트는 후속 질문에 답하고 내장 기기 도구를 사용할 수 있습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
