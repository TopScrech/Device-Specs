      "Base",
      "da",
      "de",
      "fr",
      "hi",
      "nl",
      "ru",
      "tr",
      "uk",
      "zh-Hans",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/Chit-Chat",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/ScrechKit",
      "version": {
        "up-to-next-major-version": "1.0.12",
      },
